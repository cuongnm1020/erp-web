{
  "name": "@erp/web",
  "version": "0.0.1",
  "private": true,
  "description": "Portal nội bộ CRM / CSKH (Next.js App Router). Luật: apps/web/CLAUDE.md",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"web: chưa có e2e\" && exit 0",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts",
    "gen:api:check": "openapi-typescript ../api/openapi.json -o /tmp/erp-schema.d.ts && diff -q /tmp/erp-schema.d.ts src/lib/api/schema.d.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
